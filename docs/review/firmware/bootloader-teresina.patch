+void DigitalDeInit(void* context)
+{
+    auto* hardware=static_cast<DigitalHardware*>(context);
+    if(hardware->status_timer.Stop()!=TimerHandle::Result::OK
+       || hardware->status_timer.DeInit()!=TimerHandle::Result::OK)
+        InitFailed();
+    hardware->system.DeInit();
 }
+int main()
+{
+    const uint32_t timeout_ms=startup_process();
+    System::Config syscfg; syscfg.Boost();
+    hw.system.Init(syscfg);
+    // Preserve the official USB/DFU policy: its buffers are not cache-managed.
+    SCB_DisableDCache();
+    if(hw.sdram.Init()!=SdramHandle::Result::OK) InitFailed();
+    QSPIHandle::Config qspi_cfg;
+    qspi_cfg.device=QSPIHandle::Config::Device::IS25LP064A;
+    qspi_cfg.mode=QSPIHandle::Config::Mode::MEMORY_MAPPED;
+    qspi_cfg.pin_config.io0=Pin(PORTF,8);
+    qspi_cfg.pin_config.io1=Pin(PORTF,9);
+    qspi_cfg.pin_config.io2=Pin(PORTF,7);
+    qspi_cfg.pin_config.io3=Pin(PORTF,6);
+    qspi_cfg.pin_config.clk=Pin(PORTF,10);
+    qspi_cfg.pin_config.ncs=Pin(PORTG,6);
+    if(hw.qspi.Init(qspi_cfg)!=QSPIHandle::Result::OK) InitFailed();
+    // Keep the official normal/NOPULL BOOT0 fallback selected by an invalid pin.
