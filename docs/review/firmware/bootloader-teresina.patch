+       !=Bootloader::Result::OK) InitFailed();
+    TimerHandle::Config timer_cfg;
+    timer_cfg.periph=TimerHandle::Config::Peripheral::TIM_5;
+    timer_cfg.dir=TimerHandle::Config::CounterDir::UP;
+    timer_cfg.enable_irq=true;
+    const uint32_t timer_hz=System::GetPClk1Freq()*2u;
+    if(timer_hz!=239200000u) InitFailed();
+    // Set ARR before Init: the timer enables ARR preload.
+    timer_cfg.period=timer_hz/1000u-1u;
+    if(hw.status_timer.Init(timer_cfg)!=TimerHandle::Result::OK) InitFailed();
+    hw.status_timer.SetCallback(StatusTick,&boot);
+    if(hw.status_timer.Start()!=TimerHandle::Result::OK) InitFailed();
+    if(boot.IoInit()!=Bootloader::Result::OK) InitFailed();
+    while(true) boot.LoopProcess();
+}
