+        ((RCC->PLL2DIVR & RCC_PLL2DIVR_N2) >> RCC_PLL2DIVR_N2_Pos) + 1,
+        (RCC->PLL2FRACR & RCC_PLL2FRACR_FRACN2) >> RCC_PLL2FRACR_FRACN2_Pos,
+        ((RCC->PLL2DIVR & RCC_PLL2DIVR_P2) >> RCC_PLL2DIVR_P2_Pos) + 1,
+        ((RCC->PLL2DIVR & RCC_PLL2DIVR_Q2) >> RCC_PLL2DIVR_Q2_Pos) + 1,
+        ((RCC->PLL2DIVR & RCC_PLL2DIVR_R2) >> RCC_PLL2DIVR_R2_Pos) + 1,
+        (sdcr & FMC_SDCRx_SDCLK) >> FMC_SDCRx_SDCLK_Pos,
+        (RCC->CR & RCC_CR_HSERDY) != 0,
+        (RCC->CR & RCC_CR_PLL2RDY) != 0,
+        (RCC->PLLCFGR & RCC_PLLCFGR_DIVR2EN) != 0,
+        (RCC->PLLCFGR & RCC_PLLCFGR_PLL2FRACEN) != 0,
+        (RCC->PLLCKSELR & RCC_PLLCKSELR_PLLSRC) == RCC_PLLCKSELR_PLLSRC_HSE,
+        __HAL_RCC_GET_FMC_SOURCE() == RCC_FMCCLKSOURCE_PLL2,
+        (RCC->CR & RCC_CR_HSEBYP) == 0,
+        (RCC->PLLCFGR & RCC_PLLCFGR_PLL2RGE) == RCC_PLL2VCIRANGE_2,
+        (RCC->PLLCFGR & RCC_PLLCFGR_PLL2VCOSEL) == 0
+    };
+    uint32_t sdclk_hz;
+    if(!ValidateClock(clock, sdclk_hz))
+        return false;
+    const uint32_t t = FMC_SDRAM_DEVICE->SDTR[0];
+    const uint32_t forbidden =
+        ((t & FMC_SDTRx_TWR) >> FMC_SDTRx_TWR_Pos) + 1
+        + ((t & FMC_SDTRx_TRP) >> FMC_SDTRx_TRP_Pos) + 1
+        + ((t & FMC_SDTRx_TRC) >> FMC_SDTRx_TRC_Pos) + 1
+        + ((t & FMC_SDTRx_TRCD) >> FMC_SDTRx_TRCD_Pos) + 1 + 4;
+    return CalculateCount(sdclk_hz, forbidden, count);
+}
