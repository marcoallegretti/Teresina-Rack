--- /dev/null
+++ b/src/dev/teresina_sdram_profile.h
@@ -0,0 +1,54 @@
+#pragma once
+#include <cstdint>
+
+// IS42S32160F-6BLI prototype profile, -40..85 C. Hardware qualification pending.
+namespace daisy
+{
+namespace teresina_sdram
+{
+constexpr uint32_t kRows = 8192;
+constexpr uint32_t kTargetSweepUs = 32000;
+constexpr uint32_t kLowerClockAllowancePpm = 1000;
+constexpr uint32_t kSchedulingTicks = 20;
+
+struct ClockSnapshot
+{
+    uint32_t hse_hz, m, n, fraction, p, q, r, sdclk_divider;
+    bool hse_ready, pll2_ready, r_enabled, fraction_enabled;
+    bool source_hse, source_pll2, crystal_mode, range_valid, wide_vco;
+};
+
+inline bool CalculateCount(uint32_t sdclk_hz, uint32_t forbidden_count,
+                           uint32_t& count)
+{
+    const uint64_t lower_hz = uint64_t(sdclk_hz)
+        * (1000000 - kLowerClockAllowancePpm) / 1000000;
+    const uint64_t budget = lower_hz * kTargetSweepUs
+        / (uint64_t(kRows) * 1000000);
+    if(budget < kSchedulingTicks + 1 + 58)
+        return false;
+    const uint64_t candidate = budget - kSchedulingTicks - 1;
+    if(candidate > 0x1fff || candidate == forbidden_count)
+        return false;
+    count = static_cast<uint32_t>(candidate);
+    return true;
+}
+
+inline bool ValidateClock(const ClockSnapshot& c, uint32_t& sdclk_hz)
+{
+    if(!c.hse_ready || !c.pll2_ready || !c.r_enabled || !c.fraction_enabled
+       || !c.source_hse || !c.source_pll2 || !c.crystal_mode
+       || !c.range_valid || !c.wide_vco
+       || c.hse_hz != 16000000 || c.m != 3 || c.n != 37
+       || c.fraction != 4096 || c.p != 8 || c.q != 2 || c.r != 1 || c.sdclk_divider != 2)
+        return false;
+    const uint64_t kernel = uint64_t(c.hse_hz)
+        * (uint64_t(c.n) * 8192 + c.fraction)
+        / (uint64_t(c.m) * c.r * 8192);
+    if(kernel != 200000000 || kernel / c.sdclk_divider != 100000000)
+        return false;
+    sdclk_hz = static_cast<uint32_t>(kernel / c.sdclk_divider);
+    return true;
+}
+} // namespace teresina_sdram
+} // namespace daisy
